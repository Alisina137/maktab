{
  "name": "maktablink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm verify:parent-localization && pnpm verify:parent-resilience && pnpm typecheck && pnpm test && pnpm build",
    "verify:parent-localization": "node scripts/verify-parent-localization.mjs",
    "verify:parent-resilience": "node scripts/verify-parent-resilience.mjs",
    "dev:api": "pnpm --filter @maktablink/api dev",
    "dev:web": "pnpm --filter @maktablink/web dev",
    "dev:mobile": "pnpm --filter @maktablink/mobile start",
    "db:generate": "pnpm --filter @maktablink/database db:generate",
    "db:migrate": "pnpm --filter @maktablink/database db:migrate",
    "backup:db": "node scripts/backup-database.mjs",
    "restore:db": "node scripts/restore-database.mjs",
    "ops:check": "node --check scripts/db-tool-common.mjs && node --check scripts/backup-database.mjs && node --check scripts/restore-database.mjs",
    "demo:parent-dashboard": "pnpm --filter @maktablink/database demo:parent-dashboard"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
