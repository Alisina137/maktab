{
  "name": "maktablink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @maktablink/api dev",
    "dev:web": "pnpm --filter @maktablink/web dev",
    "dev:mobile": "pnpm --filter @maktablink/mobile start",
    "db:generate": "pnpm --filter @maktablink/database db:generate",
    "db:migrate": "pnpm --filter @maktablink/database db:migrate"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
